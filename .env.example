# Copiar a .env y reemplazar los valores antes de desplegar (docker compose lo lee automáticamente).
# Los valores por defecto de docker-compose.yml son solo para la demo local.

# Firma de los JWT (HS256): mínimo 32 caracteres aleatorios. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Clave compartida para la comunicación interna order-service -> catalog-service
INTERNAL_API_KEY=cambiar-por-otra-clave-aleatoria

# Base de datos
DB_ROOT_PASSWORD=cambiar-root
USERS_DB_PASSWORD=cambiar-users
CATALOG_DB_PASSWORD=cambiar-catalog
ORDERS_DB_PASSWORD=cambiar-orders

# Puerto público de la aplicación (nginx)
APP_PORT=8080

# Puerto de MariaDB en el host, por si 3306 ya está ocupado por otro MySQL.
# Si se cambia, los servicios ejecutados fuera de Docker necesitan DB_PORT con el mismo valor.
DB_PUBLIC_PORT=3306
